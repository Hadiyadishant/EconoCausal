# ==========================================
# EconoCausal - Root .gitignore
# ==========================================

# ------------------------------------------
# Python
# ------------------------------------------

# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook
.ipynb_checkpoints/

# Python build/package files
build/
dist/
*.egg-info/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ------------------------------------------
# Environment Variables / Secrets
# ------------------------------------------

.env
.env.*
!.env.example

# ------------------------------------------
# Node / React / Vite
# ------------------------------------------

# Dependencies
node_modules/

# Vite build output
dist/

# Vite cache
.vite/
.vite-temp/

# React/Vite frontend-specific
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ------------------------------------------
# Logs
# ------------------------------------------

*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ------------------------------------------
# IDE / Editors
# ------------------------------------------

.vscode/
.idea/

# ------------------------------------------
# Operating System
# ------------------------------------------

.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------
# Temporary files
# ------------------------------------------

*.tmp
*.temp
*.swp

# ------------------------------------------
# Optional: local data
# ------------------------------------------

# Uncomment these if you later have large/private datasets
# data/raw/
# data/processed/